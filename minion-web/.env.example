# SoundWave Environment Variables Configuration

# 1. Jamendo Music API (Free Developer Access)
JAMENDO_CLIENT_ID=c34b17a1

# 2. Database Connection (PostgreSQL with Prisma)
DATABASE_URL=postgresql://soundwave:soundwave_pass@localhost:5432/soundwave_db?schema=public

# 3. NextAuth / Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_soundwave_key_change_in_production_123

# 4. Optional: YouTube Data API v3 Key (if overriding default scraper)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# 5. Optional: Spotify Web API Client (if official Spotify OAuth enabled)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
