# SoundWave Environment Variables Configuration

# 1. YouTube Data API v3 Key
# Paste your Google Cloud Console YouTube Data API v3 Key here:
YOUTUBE_API_KEY=

# 2. Jamendo Music API (Free Developer Key)
JAMENDO_CLIENT_ID=c34b17a1

# 3. Database Connection (PostgreSQL with Prisma)
DATABASE_URL=postgresql://soundwave:soundwave_pass@localhost:5432/soundwave_db?schema=public

# 4. NextAuth / Authentication Secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_soundwave_key_change_in_production_123
